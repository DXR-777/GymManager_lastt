<?xml version="1.0" encoding="utf-8"?>
<!--
    إصلاح تطابق الزوايا (2026): كان هذا التأثير (foreground) بلا أي قناع (mask)، أي مستطيل
    حاد الزوايا تمامًا، بينما يُستخدم فوق 12 حاوية دائرية الزوايا في هذه الشاشة (شرائح نوع
    الاشتراك، صناديق التاريخ، حالة الدفع، وبطاقات طريقة الدفع) — فيظهر تأثير الضغط/التحديد
    بحواف مربعة بارزة خلف الأيقونة أو الشريحة المستديرة (بالضبط الخلل الموصوف: "التأثير
    بيكون بشكل مربع"). أُضيف قناع دائري الزوايا بنفس radius_md المستخدم في أغلب هذه الحاويات
    (bg_payment_method_chip_*, bg_segment_track, bg_date_box)، فيتطابق تأثير الضغط الآن مع
    نفس شكل الإطار الأحمر عند التحديد بدل زيادة عليه. بلا أي تغيير في اللون المستخدم.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_dark">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <corners android:radius="@dimen/radius_md"/>
        </shape>
    </item>
</ripple>
