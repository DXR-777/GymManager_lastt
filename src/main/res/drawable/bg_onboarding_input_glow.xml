<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة "اسم النادي" (Onboarding 4.1): توهج بنفسجي ناعم خلف حقل الإدخال، بنفس
     نمط bg_onboarding_cta_glow (طبقتان متراكبتان) لكن بلون بنفسجي بدل مرجاني،
     مطابقةً لتوهج حدّ الحقل الأبيض-البنفسجي في المرجع. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glow_purple_softer" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:start="4dp"
        android:end="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glow_purple_soft" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</layer-list>
