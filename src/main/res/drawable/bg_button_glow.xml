<?xml version="1.0" encoding="utf-8"?>
<!--
    زر الحفظ (Save CTA) — تدقيق حالة التعطيل (2026): الهالة كانت شكلاً ثابتاً بلا حالة
    تعطيل، فتبقى زاهية خلف الزر حتى أثناء الحفظ/التعطيل بينما الزر نفسه يخفت — تعارض
    بصري. أصبحت الآن selector: تختفي الهالة (شفافة) في حالة enabled=false بدل تظهيرها
    بلونها الكامل خلف زر معطّل. نصف قطر الطبقة الوسطى (20dp) يتناقص 4dp عن الحافة
    (24dp) و4dp إضافية عن الزر نفسه (radius_button_cta = 16dp) لتداخل هندسي متّسق.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <corners android:radius="@dimen/radius_xl" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_accent_softer" />
                    <corners android:radius="@dimen/radius_xl" />
                </shape>
            </item>
            <item
                android:top="4dp"
                android:bottom="4dp"
                android:start="4dp"
                android:end="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glow_accent_soft" />
                    <corners android:radius="@dimen/radius_lg" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
