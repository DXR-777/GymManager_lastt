<?xml version="1.0" encoding="utf-8"?>
<!-- شاشات "إعداد النادي" (Onboarding 4 من 4 — معالج متعدد الخطوات): شريحة مؤشر
     التقدّم النشطة/المكتملة، بنفس تدرّج brand_gradient الأفقي المستخدم في بقية
     مؤشرات وأزرار الإعداد الأولي. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/brand_gradient_start"
        android:endColor="@color/brand_gradient_end" />
    <corners android:radius="@dimen/radius_full" />
</shape>
