<?xml version="1.0" encoding="utf-8"?>
<!--
    بطاقة العضو الواحد (قائمة الأعضاء) — Dark Glassmorphism 2026.
    كل المعرِّفات (IDs) المستخدمة عبر ViewBinding في MembersAdapter.kt محفوظة حرفياً كما
    كانت: cardRoot, tvInitial, tvName, tvPhone, tvTypeBadge, tvPaymentBadge,
    tvDaysRemaining, btnWhatsapp. لا تغيير في نوع أي View يحمل معرِّفاً موجوداً، ولا في أي
    منطق ربط بيانات — تغيير العرض البصري (خلفيات، تباعد، تدرّجات) فقط.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_member_card_glass"
    android:elevation="@dimen/elevation_card_resting"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <!-- حلقة تدرّج زخرفية حول الأفاتار — جديدة، لا تمسّ tvInitial نفسه ولا خلفيته الأصلية -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_avatar_ring_gradient"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvInitial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            tools:text="م" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Text.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold"
            tools:text="محمد أحمد" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_phone"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvPhone"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:textDirection="ltr"
                tools:text="0599999999" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTypeBadge"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_type_badge_glass"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xs"
                android:textColor="@color/text_secondary"
                tools:text="شهري" />

            <TextView
                android:id="@+id/tvPaymentBadge"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_pill_success"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xs"
                android:textColor="@color/status_success"
                android:textStyle="bold"
                tools:text="مدفوع" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDaysRemaining"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_days_chip_glass"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xs"
            android:textStyle="bold"
            tools:text="باقي 5 يوم" />

        <ImageButton
            android:id="@+id/btnWhatsapp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_whatsapp_button_glass"
            android:contentDescription="@string/detail_action_whatsapp"
            android:padding="8dp"
            android:src="@drawable/ic_whatsapp" />
    </LinearLayout>

</LinearLayout>
