<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/scrollDashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/Text.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="صباح الخير ☀️"/>

                <TextView
                    android:id="@+id/tvGymName"
                    style="@style/Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    tools:text="نادي القوة الرياضي"/>

            </LinearLayout>

        </LinearLayout>

        <!-- شبكة 2x2 من بطاقات المؤشرات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardActiveMembers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:background="@drawable/bg_card_glass"
                android:elevation="@dimen/elevation_card_resting"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:backgroundTint="@color/brand_accent"
                    android:padding="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_people"
                    app:tint="@android:color/white" />
                <TextView android:id="@+id/tvActiveMembersCount" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" tools:text="24"/>
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/dashboard_active_members"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:background="@drawable/bg_card_glass"
                android:elevation="@dimen/elevation_card_resting"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">
                <ImageView
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:backgroundTint="@color/status_success"
                    android:padding="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_money"
                    app:tint="@android:color/white" />
                <TextView android:id="@+id/tvTodayRevenue" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:textColor="@color/status_success" tools:text="120 ₪"/>
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/dashboard_today_revenue"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardUnpaid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:background="@drawable/bg_card_glass"
                android:elevation="@dimen/elevation_card_resting"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:backgroundTint="@color/status_error"
                    android:padding="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wallet_minimal"
                    app:tint="@android:color/white" />
                <TextView android:id="@+id/tvUnpaidCount" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:textColor="@color/status_error" tools:text="3"/>
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/dashboard_unpaid_count"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardExpiringSoon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/spacing_xs"
                android:background="@drawable/bg_card_glass"
                android:elevation="@dimen/elevation_card_resting"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:backgroundTint="@color/status_warning"
                    android:padding="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_range"
                    app:tint="@android:color/white" />
                <TextView android:id="@+id/tvExpiringSoonCount" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:textColor="@color/status_warning" tools:text="5"/>
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/dashboard_expiring_soon"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ينتهي اشتراكهم قريباً -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/status_warning"
                android:text="@string/dashboard_expiring_section" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/status_warning_bg"
                android:padding="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar_range"
                app:tint="@color/status_warning" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpiringSoon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_header_gap"
            android:orientation="horizontal"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyExpiring"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_header_gap"
            android:background="@drawable/bg_card_glass"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_lg"
            android:text="@string/dashboard_empty_expiring"
            android:visibility="gone" />

        <!-- لم يدفعوا بعد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/status_error"
                android:text="@string/dashboard_unpaid_section" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/status_error_bg"
                android:padding="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wallet_minimal"
                app:tint="@color/status_error" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUnpaid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_header_gap"
            android:orientation="horizontal"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyUnpaid"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_header_gap"
            android:background="@drawable/bg_card_glass"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_lg"
            android:text="@string/dashboard_empty_unpaid"
            android:visibility="gone" />

    </LinearLayout>
    </ScrollView>

    <!-- البند 15: تُعرض فوق الشاشة الرئيسية أثناء أول تحميل فقط (قبل أول انبعاث من
         DashboardViewModel.uiState)، بدل ظهور الشاشة فارغة (كل الأرقام أصفار
         والقوائم "لا يوجد") للحظة قبل التعبئة الفعلية بالبيانات. -->
    <ProgressBar
        android:id="@+id/progressDashboardLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

</FrameLayout>
