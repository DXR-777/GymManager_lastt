<?xml version="1.0" encoding="utf-8"?>
<!--
  البند 3 (خصوصية بيانات العملاء) — راجع الشرح الكامل في backup_rules.xml (الملف المكافئ
  لهذا للإصدارات الأقدم من أندرويد 12). نفس المنطق هنا لكلا القناتين: النسخ الاحتياطي
  السحابي لحساب Google (cloud-backup) ونقل الجهاز المباشر (device-transfer) — قاعدة
  بيانات النادي (أسماء/هواتف الأعضاء، الأسعار، الديون، بيانات المُرسِلين) مُستبعَدة الآن
  من كليهما، ويبقى نقلها الوحيد عبر ميزة النسخ الاحتياطي الصريحة التي يبدؤها المستخدم
  بوعي (BackupManager) لا عبر آلية أندرويد الصامتة.
-->
<data-extraction-rules>
    <!-- قفل التطبيق: app_lock.xml مُستبعَد عمداً — بصمة الرمز (HMAC) مرتبطة بمفتاح داخل
         Android Keystore لا ينتقل مع النسخ الاحتياطي/الجهاز الجديد، فلو استُعيد الملف وحده
         لصار الرمز "خاطئاً" دائماً على الجهاز الجديد ولا يمكن فتح التطبيق بلا استرداد. -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="app_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="app_lock.xml" />
    </device-transfer>
</data-extraction-rules>
