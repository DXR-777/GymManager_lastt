<?xml version="1.0" encoding="utf-8"?>
<!--
    شاشة "تفاصيل العضو" — تصميم Membership Pass (2026):
    1) بطاقة العضوية بتدرّج الهوية: الخطة وحالة الدفع، الصورة والاسم والهاتف، تاريخ الانتهاء والأيام المتبقية + شريط التقدّم
    2) شريط سياقي: المتبقي غير المدفوع + تسديد، أو تنبيه الانتهاء + تجديد
    3) إجراءات سريعة دائرية (اتصال · واتساب · رسالة · مشاركة)
    4) تبويبان: السجل (بطاقات الاشتراكات مع طريقة الدفع) والملاحظات
    5) منطقة حذف هادئة في الأسفل.
    كل أهداف اللمس ≥ 48dp. الفراغات من شبكة 8dp وهوامش جانبية 20dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_orbs"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- الشريط العلوي 64dp: رجوع (بداية) · عنوان · المزيد (نهاية) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/home_pad">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_glass_circle"
                android:contentDescription="@string/action_back"
                android:foreground="@drawable/ripple_home_circle"
                android:padding="12dp"
                android:src="@drawable/ic_pd_back"
                app:tint="@color/home_ink" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/detail_screen_title"
                android:textColor="@color/home_ink"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_glass_circle"
                android:contentDescription="@string/detail_more_cd"
                android:foreground="@drawable/ripple_home_circle"
                android:padding="12dp"
                android:src="@drawable/ic_pd_more"
                app:tint="@color/home_ink" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:id="@+id/contentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/home_pad"
                android:paddingTop="8dp"
                android:paddingBottom="48dp">

                <!-- ======== 1) بطاقة العضوية ======== -->
                <LinearLayout
                    android:id="@+id/passCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_detail_pass_active"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPlanLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/cairo_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#E6F5F6FF"
                            android:textSize="14sp"
                            tools:text="عضوية شهرية · بال باي" />

                        <FrameLayout
                            android:id="@+id/chipPayment"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_detail_pass_chip">

                            <TextView
                                android:id="@+id/tvCurrentPaidBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:drawableStart="@drawable/bg_detail_dot8"
                                android:drawablePadding="8dp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="14dp"
                                android:textColor="@color/home_ink"
                                android:textSize="13sp"
                                tools:text="مدفوع" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInitial"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_detail_pass_avatar"
                            android:fontFamily="@font/cairo_extrabold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textColor="@color/home_ink"
                            android:textSize="30sp"
                            tools:text="ي" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/cairo_extrabold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/home_ink"
                                android:textSize="24sp"
                                tools:text="يس" />

                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/cairo_medium"
                                android:includeFontPadding="false"
                                android:textAlignment="viewStart"
                                android:textColor="#D9F5F6FF"
                                android:textDirection="ltr"
                                android:textSize="15sp"
                                tools:text="0858885858" />

                            <TextView
                                android:id="@+id/tvMemberSince"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/cairo_regular"
                                android:includeFontPadding="false"
                                android:textColor="#B3F5F6FF"
                                android:textSize="12sp"
                                tools:text="عضو منذ 15 نوفمبر 2026" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/blockExpires"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo_regular"
                                android:includeFontPadding="false"
                                android:text="@string/detail_pass_expires"
                                android:textColor="#CCF5F6FF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvCurrentDates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/cairo_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/home_ink"
                                android:textSize="17sp"
                                tools:text="14 ديسمبر 2026" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- الأيام المتبقية: رقم ضخم + وحدة صغيرة -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDaysNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo_extrabold"
                                android:fontFeatureSettings="tnum"
                                android:includeFontPadding="false"
                                android:textColor="@color/home_ink"
                                android:textSize="52sp"
                                tools:text="29" />

                            <TextView
                                android:id="@+id/tvDaysUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="@font/cairo_medium"
                                android:includeFontPadding="false"
                                android:textColor="#E6F5F6FF"
                                android:textSize="14sp"
                                tools:text="يوماً متبقياً" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressSubscription"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:progressDrawable="@drawable/progress_detail_pass"
                        tools:progress="30" />

                    <TextView
                        android:id="@+id/tvCurrentSenderInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/cairo_regular"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#CCF5F6FF"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="أحمد · 0599999999" />
                </LinearLayout>

                <!-- ======== 2) الشريط السياقي: أيقونة حالة + نص في سطر واحد + زر ======== -->
                <LinearLayout
                    android:id="@+id/cardStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_detail_strip_coral"
                    android:gravity="center_vertical"
                    android:minHeight="80dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivStripIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_detail_strip_icon"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_pd_alert" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStripCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:fontFamily="@font/cairo_regular"
                            android:includeFontPadding="false"
                            android:textColor="@color/home_mute"
                            android:textSize="13sp"
                            tools:text="المتبقي غير المدفوع" />

                        <TextView
                            android:id="@+id/tvStripValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_bold"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/home_coral"
                            android:textSize="16sp"
                            tools:text="₪ 5" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnPrimaryAction"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_home_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="112dp"
                        android:paddingHorizontal="24dp"
                        android:text="@string/action_settle_debt"
                        android:textColor="@color/home_ink"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- ======== 3) الإجراءات السريعة ======== -->
                <LinearLayout
                    android:id="@+id/rowActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_detail_action_circle"
                            android:importantForAccessibility="no"
                            android:padding="16dp"
                            android:src="@drawable/ic_pd_phone"
                            app:tint="@color/home_lav" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/detail_action_call" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_detail_action_circle_wa"
                            android:importantForAccessibility="no"
                            android:padding="16dp"
                            android:src="@drawable/ic_pd_whatsapp"
                            app:tint="#34D399" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/detail_action_whatsapp_short" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnSms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_detail_action_circle"
                            android:importantForAccessibility="no"
                            android:padding="16dp"
                            android:src="@drawable/ic_pd_sms"
                            app:tint="@color/home_lav" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/detail_action_sms" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnShare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:minHeight="88dp"
                        android:orientation="vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_detail_action_circle"
                            android:importantForAccessibility="no"
                            android:padding="16dp"
                            android:src="@drawable/ic_pd_share"
                            app:tint="@color/home_lav" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/detail_action_share" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ======== 4) التبويبان: السجل · الملاحظات ======== -->
                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabHistory"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/detail_tab_history"
                        android:textColor="@color/home_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tabNotes"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/detail_tab_notes"
                        android:textColor="@color/home_mute"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/tabContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <!-- تبويب السجل -->
                    <LinearLayout
                        android:id="@+id/sectionHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHistorySummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/cairo_regular"
                                android:includeFontPadding="false"
                                android:textColor="@color/home_mute"
                                android:textSize="13sp"
                                tools:text="الاشتراكات 1 · إجمالي المدفوع ₪ 0" />

                            <ImageView
                                android:id="@+id/btnHistorySort"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_detail_circle40"
                                android:contentDescription="@string/members_sort_action"
                                android:foreground="@drawable/ripple_home_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_pd_sort"
                                app:tint="@color/home_ink" />
                        </LinearLayout>

                        <!-- شرائح الفلتر (تظهر فقط عند وجود 3 اشتراكات أو أكثر) + مؤشر منزلق -->
                        <HorizontalScrollView
                            android:id="@+id/chipRowScroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:scrollbars="none"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="48dp">

                                <View
                                    android:id="@+id/chipIndicator"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="left|top"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_home_chip_active"
                                    android:importantForAccessibility="no"
                                    tools:ignore="RtlHardcoded" />

                                <LinearLayout
                                    android:id="@+id/chipRow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:id="@+id/chipHistoryAll"
                                        style="@style/DetailFilterChip">

                                        <TextView
                                            android:id="@+id/tvChipAllLabel"
                                            style="@style/DetailFilterChipLabel"
                                            android:text="@string/members_filter_all" />

                                        <TextView
                                            android:id="@+id/tvChipAllCount"
                                            style="@style/DetailFilterChipCount" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/chipHistoryPaid"
                                        style="@style/DetailFilterChip">

                                        <TextView
                                            android:id="@+id/tvChipPaidLabel"
                                            style="@style/DetailFilterChipLabel"
                                            android:text="@string/status_paid" />

                                        <TextView
                                            android:id="@+id/tvChipPaidCount"
                                            style="@style/DetailFilterChipCount" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/chipHistoryPartial"
                                        style="@style/DetailFilterChip">

                                        <TextView
                                            android:id="@+id/tvChipPartialLabel"
                                            style="@style/DetailFilterChipLabel"
                                            android:text="@string/payment_status_partial" />

                                        <TextView
                                            android:id="@+id/tvChipPartialCount"
                                            style="@style/DetailFilterChipCount" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/chipHistoryUnpaid"
                                        style="@style/DetailFilterChip">

                                        <TextView
                                            android:id="@+id/tvChipUnpaidLabel"
                                            style="@style/DetailFilterChipLabel"
                                            android:text="@string/members_filter_unpaid" />

                                        <TextView
                                            android:id="@+id/tvChipUnpaidCount"
                                            style="@style/DetailFilterChipCount" />
                                    </LinearLayout>
                                </LinearLayout>
                            </FrameLayout>
                        </HorizontalScrollView>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:nestedScrollingEnabled="false" />

                        <!-- حالة التحميل: هيكل عظمي لبطاقتين -->
                        <LinearLayout
                            android:id="@+id/layoutHistorySkeleton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:importantForAccessibility="no"
                            android:orientation="vertical">

                            <include layout="@layout/item_subscription_skeleton" />

                            <include layout="@layout/item_subscription_skeleton" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnHistoryLoadMore"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_detail_btn_glass"
                            android:clickable="true"
                            android:drawableEnd="@drawable/ic_pd_chevron_down"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/home_mute"
                            android:focusable="true"
                            android:fontFamily="@font/cairo_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minWidth="160dp"
                            android:paddingHorizontal="20dp"
                            android:text="@string/detail_history_load_more"
                            android:textColor="@color/home_mute"
                            android:textSize="14sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/cardEmptyHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_detail_empty"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="32dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_pd_empty" />

                            <TextView
                                android:id="@+id/tvEmptyHistory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/detail_history_empty"
                                android:textColor="@color/home_ink"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvEmptyHistoryHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/cairo_regular"
                                android:gravity="center"
                                android:lineSpacingExtra="4dp"
                                android:text="@string/detail_history_empty_hint"
                                android:textColor="@color/home_mute"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- تبويب الملاحظات -->
                    <LinearLayout
                        android:id="@+id/sectionNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/cardNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_detail_card"
                            android:gravity="center_vertical"
                            android:minHeight="88dp"
                            android:orientation="horizontal"
                            android:paddingVertical="16dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/tvNotes"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/cairo_regular"
                                android:lineSpacingExtra="4dp"
                                android:textColor="@color/home_ink"
                                android:textSize="14sp"
                                tools:text="لا توجد ملاحظات" />

                            <ImageView
                                android:id="@+id/btnNotesEdit"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/detail_notes_edit_cd"
                                android:padding="12dp"
                                android:src="@drawable/ic_pd_edit"
                                app:tint="@color/home_mute" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- ======== 5) منطقة الحذف ======== -->
                <LinearLayout
                    android:id="@+id/dangerZone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_detail_line"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:id="@+id/btnDelete"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_detail_delete"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pd_trash"
                            app:tint="@color/home_coral" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/cairo_bold"
                            android:includeFontPadding="false"
                            android:text="@string/detail_action_delete"
                            android:textColor="@color/home_coral"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
