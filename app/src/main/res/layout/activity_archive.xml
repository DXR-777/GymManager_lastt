<?xml version="1.0" encoding="utf-8"?>
<!--
    شاشة "الأعضاء المحذوفون" (إعادة تصميم 2026، نفس لغة الرئيسية والأعضاء): خلفية #0A0B1E + كرات ضبابية،
    رأس بزر رجوع زجاجي وعنوان وعدّاد وزر "استعادة الكل"، شريط بحث زجاجي، ملاحظة المهلة، قائمة بطاقات،
    وحالة فارغة بدائرة متوهّجة. كل المعرِّفات القديمة محفوظة (+ archiveContent, tvArchiveCount).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_orbs"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/archiveContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/home_pad"
        android:paddingTop="8dp">

        <!-- الرأس: رجوع + عنوان/عدّاد + شارة الأرشيف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_home_tile"
                android:contentDescription="@string/action_back"
                android:foreground="@drawable/ripple_home_circle"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                app:tint="@color/home_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/cairo_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/archive_title"
                    android:textColor="@color/home_ink"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvArchiveCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/home_mute"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRestoreAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_archive_btn_restore"
                android:clickable="true"
                android:drawableStart="@drawable/ic_restore"
                android:drawablePadding="6dp"
                android:drawableTint="@color/home_mint"
                android:focusable="true"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="14dp"
                android:text="@string/archive_restore_all"
                android:textColor="@color/home_mint"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- شريط البحث الزجاجي (نفس شاشة الأعضاء) -->
        <LinearLayout
            android:id="@+id/archiveSearchBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_members_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/home_mute" />

            <EditText
                android:id="@+id/etArchiveSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/members_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLength="60"
                android:maxLines="1"
                android:paddingVertical="8dp"
                android:textColor="@color/home_ink"
                android:textColorHint="@color/home_mute"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnClearArchiveSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_home_circle"
                android:contentDescription="@string/archive_clear_search"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/home_mute" />
        </LinearLayout>

        <!-- ملاحظة المهلة: تشرح أن المحذوف يمكن استعادته قبل الحذف النهائي -->
        <LinearLayout
            android:id="@+id/archiveNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_note"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ds_clock"
                app:tint="@color/home_lav" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_regular"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/archive_note"
                android:textColor="@color/home_lav"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvArchived"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/home_pad_negative"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_fall_down"
            android:paddingHorizontal="@dimen/home_pad"
            android:paddingTop="14dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/emptyArchiveContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="40dp"
            android:visibility="gone">

            <!-- رسم الأرشيف الفارغ المتحرك (OrbitAnimator). الحلقات مُزاحة 6dp داخل حاوية الدوران، والنقاط
                 مركّزها على محيط الحلقة تماماً — فلا تُقصّ أبداً (كانت تظهر نصف دائرة). -->
            <FrameLayout
                android:id="@+id/orbitRoot"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:clipChildren="false"
                android:importantForAccessibility="no">

                <View
                    android:id="@+id/orbitRipple1"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/bg_members_orbit_inner" />

                <View
                    android:id="@+id/orbitRipple2"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/bg_members_orbit_inner" />

                <View
                    android:id="@+id/orbitGlow"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_archive_glow" />

                <FrameLayout
                    android:id="@+id/orbitRotorOuter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_members_orbit_outer" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="79dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_members_dot"
                        android:backgroundTint="@color/home_dot_lav" />
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="34dp"
                        android:layout_marginTop="143dp"
                        android:background="@drawable/bg_members_dot"
                        android:backgroundTint="@color/home_dot_blue" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/orbitRotorInner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="26dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_members_orbit_inner" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="28dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_members_dot"
                        android:backgroundTint="@color/home_dot_pink" />
                </FrameLayout>

                <!-- ظلّ الأرض: ثابت تحت الصندوق الطافي -->
                <View
                    android:id="@+id/archiveShadow"
                    android:layout_width="78dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="118dp"
                    android:background="@drawable/bg_archive_shadow"
                    android:importantForAccessibility="no" />

                <!-- النواة = صندوق أرشيف مغلق ثلاثي الأبعاد. orbitCore يتولّى الطفو/التنفّس (OrbitAnimator)،
                     و archiveBoxGroup يتولّى الاهتزاز والانضغاط، والغطاء يُرفع ويعود (ArchiveBoxAnimator). -->
                <FrameLayout
                    android:id="@+id/orbitCore"
                    android:layout_width="92dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:contentDescription="@string/archive_empty"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/archiveBoxGroup"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false">

                        <ImageView
                            android:layout_width="92dp"
                            android:layout_height="62dp"
                            android:layout_gravity="bottom"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/archive_box" />

                        <View
                            android:id="@+id/archiveDust1"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="22dp"
                            android:alpha="0"
                            android:background="@drawable/bg_members_dot"
                            android:backgroundTint="@color/home_dot_lav" />

                        <View
                            android:id="@+id/archiveDust2"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="24dp"
                            android:layout_marginStart="26dp"
                            android:alpha="0"
                            android:background="@drawable/bg_members_dot"
                            android:backgroundTint="@color/home_dot_blue" />

                        <View
                            android:id="@+id/archiveDust3"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="23dp"
                            android:layout_marginEnd="26dp"
                            android:alpha="0"
                            android:background="@drawable/bg_members_dot"
                            android:backgroundTint="@color/home_dot_pink" />

                        <ImageView
                            android:id="@+id/archiveLid"
                            android:layout_width="92dp"
                            android:layout_height="30dp"
                            android:layout_gravity="top"
                            android:layout_marginTop="4dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/archive_lid" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvArchiveEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/archive_empty"
                android:textColor="@color/home_ink"
                android:textSize="20sp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArchiveEmptyBack"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/action_back"
                android:textColor="@color/home_ink"
                app:cornerRadius="99dp"
                app:rippleColor="@color/ripple_on_dark"
                app:strokeColor="@color/home_glass_stroke" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
