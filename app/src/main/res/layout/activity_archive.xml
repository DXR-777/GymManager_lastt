<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- رأس مخصَّص بنفس مواصفات رأس شاشة إضافة/تعديل عضو المرجعية (راجع activity_member_detail.xml):
         btnBack يحلّ محلّ toolbar.setNavigationOnClickListener، والعنوان صار tvToolbarTitle
         بنمط Text.Title المتمركز بدل عنوان Toolbar الافتراضي المحاذى للبداية. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/archive_title" />

        <ImageView
            android:layout_width="@dimen/icon_badge_size"
            android:layout_height="@dimen/icon_badge_size"
            android:background="@drawable/bg_icon_badge"
            android:backgroundTint="@color/brand_accent"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_archive"
            app:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_sm"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_search_bar_glass"
        android:elevation="@dimen/elevation_card_resting"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <!-- البند 2: نفس ملاحظة etSearch في fragment_members.xml — خانة بحث الأرشيف
             كانت أيضاً بلا maxLength. -->
        <EditText
            android:id="@+id/etArchiveSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@android:color/transparent"
            android:hint="@string/members_search_hint"
            android:paddingVertical="@dimen/spacing_sm"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="60"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnClearArchiveSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_selectable_dark"
            android:contentDescription="@string/archive_clear_search"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvArchived"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_lg" />

    <LinearLayout
        android:id="@+id/emptyArchiveContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- الحالة الفارغة داخل بطاقة زجاجية: نفس بنية emptyMembersContainer في fragment_members.xml -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_xl"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_xl">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.35"
                android:contentDescription="@null"
                android:src="@drawable/ic_archive"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvArchiveEmptyMessage"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:text="@string/archive_empty" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
