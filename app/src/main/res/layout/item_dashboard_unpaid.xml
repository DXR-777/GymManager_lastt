<?xml version="1.0" encoding="utf-8"?>
<!--
    صف "لم يدفعوا بعد" — مطابق لـ .u في تصميم HTML: أفاتار 44dp + الاسم/سبب الاستحقاق،
    ثم المبلغ بلون coral وزر "تسديد" متدرّج. فاصل علوي لكل صف عدا الأول.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/home_line" />

    <LinearLayout
        android:id="@+id/rowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_home_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp">

        <TextView
            android:id="@+id/tvInitial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_home_avatar"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/home_ink"
            android:textSize="18sp"
            tools:text="س" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/home_ink"
                android:textSize="15sp"
                tools:text="سعد الحربي" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/home_mute"
                android:textSize="12sp"
                tools:text="مستحق منذ أسبوع" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/home_coral"
            android:textSize="16sp"
            tools:text="₪ 150" />

        <TextView
            android:id="@+id/btnPay"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_home_pay"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="56dp"
            android:paddingHorizontal="14dp"
            android:text="@string/home_pay_action"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
