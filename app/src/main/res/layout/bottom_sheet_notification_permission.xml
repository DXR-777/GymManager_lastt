<?xml version="1.0" encoding="utf-8"?>
<!--
    ورقة سفلية تمهيدية (Soft Ask) قبل حوار إذن الإشعارات في النظام — تحلّ محل AlertDialog القديم.
    أسس التصميم (من أفضل ممارسات تطبيقات الإشعارات):
      1) عرض القيمة المحددة قبل الطلب (ماذا سيصلني ولماذا)،
      2) معاينة إشعار حقيقي الشكل لبناء الثقة،
      3) زر إجراء رئيسي واضح + رفض لطيف ("ليس الآن") لا يحرق فرصة الطلب،
      4) تطمين بأنه يمكن تغيير القرار لاحقاً.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_glass"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/divider_line"
            android:importantForAccessibility="no" />

        <!-- البطل: جرس 3D داخل مدارات وتوهّج -->
        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:clipChildren="false"
            android:importantForAccessibility="no">

            <View
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_notif_hero_glow" />

            <View
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_notif_orbit_ring" />

            <View
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_notif_orbit_ring" />

            <ImageView
                android:id="@+id/imgNotifBell"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_bell_3d" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_notif_dot"
                android:backgroundTint="#E39BB0" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_notif_dot"
                android:backgroundTint="@color/home_lav" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="26dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_notif_dot"
                android:backgroundTint="@color/home_blue" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNotifTitle"
            style="@style/Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/notif_sheet_title"
            android:textSize="22sp" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/notif_sheet_subtitle" />

        <!-- معاينة إشعار نموذجي -->
        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/notif_sheet_preview_label"
            android:textColor="@color/home_mute" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_notif_preview"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_notif_app_icon"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textColor="@color/home_mute" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_sheet_preview_time"
                        android:textColor="@color/home_mute" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/notif_sheet_preview_title"
                    android:textColor="@color/home_ink"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/notif_sheet_preview_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- الفوائد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_home_glass_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_home_tile"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_calendar_check2"
                    app:tint="@color/home_lav" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_benefit_expiring_title"
                        android:textColor="@color/home_ink"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/notif_benefit_expiring_desc" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_glass_stroke"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_home_tile"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_wallet_minimal"
                    app:tint="@color/home_lav" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_benefit_unpaid_title"
                        android:textColor="@color/home_ink"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/notif_benefit_unpaid_desc" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNotifAllow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_cta"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_home_cta"
            android:clickable="true"
            android:contentDescription="@string/notif_sheet_allow"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ds_bell"
                app:tint="@color/white" />

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/notif_sheet_allow"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifLater"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/notif_sheet_later"
            android:textColor="@color/home_mute"
            android:textSize="14sp" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/notif_sheet_footnote"
            android:textColor="@color/home_mute"
            android:alpha="0.75" />
    </LinearLayout>
</ScrollView>
