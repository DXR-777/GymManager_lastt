<?xml version="1.0" encoding="utf-8"?>
<!--
    ورقة "ترتيب القائمة": بدل حوار Material الرمادي الافتراضي — أيقونة لكل خيار، وصف قصير،
    والخيار الحالي يُبرَز ببطاقة بنفسجية ومؤشّر متدرّج بعلامة صح (الباقي بحلقة فارغة).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_home_grabber"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/cairo_extrabold"
        android:includeFontPadding="false"
        android:text="@string/members_sort_cd"
        android:textColor="@color/home_ink"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/cairo_regular"
        android:includeFontPadding="false"
        android:text="@string/members_sort_subtitle"
        android:textColor="@color/home_mute"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/rowSortName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_sort_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_home_sort_tile"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_ds_sort_az"
            app:tint="@color/home_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:text="@string/members_sort_name"
                android:textColor="@color/home_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/cairo_regular"
                android:includeFontPadding="false"
                android:text="@string/members_sort_name_desc"
                android:textColor="@color/home_mute"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioSortName"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_home_radio_off"
            android:importantForAccessibility="no"
            android:padding="5dp"
            app:tint="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rowSortExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_sort_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_home_sort_tile"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_ds_clock"
            app:tint="@color/home_lav" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:text="@string/members_sort_expiry_soonest"
                android:textColor="@color/home_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/cairo_regular"
                android:includeFontPadding="false"
                android:text="@string/members_sort_expiry_desc"
                android:textColor="@color/home_mute"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioSortExpiry"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_home_radio_off"
            android:importantForAccessibility="no"
            android:padding="5dp"
            app:tint="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rowSortNewest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_sort_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_home_sort_tile"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_ds_calendar_new"
            app:tint="@color/home_amber" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:text="@string/members_sort_newest"
                android:textColor="@color/home_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/cairo_regular"
                android:includeFontPadding="false"
                android:text="@string/members_sort_newest_desc"
                android:textColor="@color/home_mute"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radioSortNewest"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_home_radio_off"
            android:importantForAccessibility="no"
            android:padding="5dp"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
