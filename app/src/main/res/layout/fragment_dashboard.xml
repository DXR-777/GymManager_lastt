<?xml version="1.0" encoding="utf-8"?>
<!--
    الشاشة الرئيسية — مطابقة حرفية لتصميم HTML "إدارة الجيم – الرئيسية":
    خلفية #0A0B1E + ثلاث كرات ضبابية، رأس (أفاتار + تحية + جرس)، بطاقة Hero متدرّجة
    (إيرادات + رسم مصغّر + مفتاح اليوم/الأسبوع/الشهر + لوحة مؤشرات من ثلاثة صفوف)،
    قسمان: شريط أفقي لمن تنتهي اشتراكاتهم، وبطاقة زجاجية بقائمة من لم يدفعوا.
    كل المعرّفات (ids) المستخدمة في DashboardFragment محفوظة كما كانت.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <View
        android:id="@+id/homeOrbs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_orbs"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scrollDashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:tag="nav_inset_target">

        <com.gympro.manager.ui.widgets.MaxWidthFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/home_pad"
                android:paddingTop="16dp"
                android:paddingBottom="@dimen/home_bottom_extra">

                <!-- ============ الرأس ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_home_avatar"
                        android:fontFamily="@font/cairo_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/home_ink"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="ق" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_medium"
                            android:includeFontPadding="false"
                            android:textColor="@color/home_mute"
                            android:textSize="12sp"
                            tools:text="صباح الخير" />

                        <TextView
                            android:id="@+id/tvGymName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/cairo_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/home_ink"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            tools:text="نادي القوة" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnBell"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_home_glass_circle"
                        android:clickable="true"
                        android:contentDescription="@string/home_notifications"
                        android:focusable="true"
                        android:foreground="@drawable/ripple_home_circle">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ds_bell"
                            app:tint="@color/home_ink" />

                        <View
                            android:id="@+id/bellDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="11dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shape_dot"
                            android:backgroundTint="@color/home_crim"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ============ بطاقة Hero ============ -->
                <LinearLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_home_hero"
                    android:clipToOutline="true"
                    android:elevation="14dp"
                    android:minHeight="272dp"
                    android:orientation="horizontal"
                    android:outlineSpotShadowColor="@color/home_hero_end"
                    tools:targetApi="p">

                    <!-- العمود الأيمن (RTL): الإيرادات -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:id="@+id/tvRevenueTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_medium"
                            android:includeFontPadding="false"
                            android:text="@string/home_revenue_day"
                            android:textColor="@color/home_hero_title"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCurrencySymbol"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cairo_medium"
                                android:includeFontPadding="true"
                                android:textColor="@color/home_hero_symbol"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="₪" />

                            <TextView
                                android:id="@+id/tvTodayRevenue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/cairo_medium"
                                android:includeFontPadding="true"
                                android:maxLines="1"
                                android:paddingTop="2dp"
                                android:textColor="@color/home_ink"
                                android:textSize="42sp"
                                android:textStyle="bold"
                                tools:text="1,240" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRevenueDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_home_chip"
                            android:fontFamily="@font/cairo_medium"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="11dp"
                            android:paddingVertical="5dp"
                            android:textColor="@color/home_ink"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="↗ 18% عن أمس" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:id="@+id/barsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginBottom="14dp"
                            android:gravity="bottom"
                            android:importantForAccessibility="no"
                            android:orientation="horizontal"
                            android:paddingTop="12dp" />

                        <LinearLayout
                            android:id="@+id/segPeriod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_home_seg"
                            android:orientation="horizontal"
                            android:padding="3dp">

                            <TextView
                                android:id="@+id/segMonth"
                                style="@style/HomeSegItem"
                                android:text="@string/home_period_month" />

                            <TextView
                                android:id="@+id/segWeek"
                                style="@style/HomeSegItem"
                                android:text="@string/home_period_week" />

                            <TextView
                                android:id="@+id/segDay"
                                style="@style/HomeSegItem"
                                android:text="@string/home_period_day" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- اللوحة اليسرى (RTL): ثلاثة مؤشرات -->
                    <LinearLayout
                        android:layout_width="148dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_hero_panel"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/cardActiveMembers"
                            style="@style/HomePanelRow">

                            <ImageView
                                style="@style/HomePanelTile"
                                android:src="@drawable/ic_ds_users"
                                app:tint="@color/home_blue" />

                            <LinearLayout style="@style/HomePanelText">

                                <TextView
                                    android:id="@+id/tvActiveMembersCount"
                                    style="@style/HomePanelNumber"
                                    android:textColor="@color/home_blue"
                                    tools:text="86" />

                                <TextView
                                    style="@style/HomePanelLabel"
                                    android:text="@string/dashboard_active_members" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/home_line" />

                        <LinearLayout
                            android:id="@+id/cardUnpaid"
                            style="@style/HomePanelRow">

                            <ImageView
                                style="@style/HomePanelTile"
                                android:src="@drawable/ic_ds_receipt"
                                app:tint="@color/home_coral" />

                            <LinearLayout style="@style/HomePanelText">

                                <TextView
                                    android:id="@+id/tvUnpaidCount"
                                    style="@style/HomePanelNumber"
                                    android:textColor="@color/home_coral"
                                    tools:text="7" />

                                <TextView
                                    style="@style/HomePanelLabel"
                                    android:text="@string/home_unpaid_short" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/home_line" />

                        <LinearLayout
                            android:id="@+id/cardExpiringSoon"
                            style="@style/HomePanelRow">

                            <ImageView
                                style="@style/HomePanelTile"
                                android:src="@drawable/ic_ds_clock"
                                app:tint="@color/home_lav" />

                            <LinearLayout style="@style/HomePanelText">

                                <TextView
                                    android:id="@+id/tvExpiringSoonCount"
                                    style="@style/HomePanelNumber"
                                    android:textColor="@color/home_lav"
                                    tools:text="5" />

                                <TextView
                                    style="@style/HomePanelLabel"
                                    android:text="@string/dashboard_expiring_soon" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ ينتهي اشتراكهم قريباً ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HomeSectionTitle"
                        android:text="@string/dashboard_expiring_section" />

                    <TextView
                        android:id="@+id/tvExpiringSectionCount"
                        style="@style/HomeSectionCount"
                        android:background="@drawable/bg_home_count_vio"
                        android:textColor="@color/home_lav"
                        android:visibility="gone"
                        tools:text="5"
                        tools:visibility="visible" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnViewAllExpiring"
                        style="@style/HomeViewAll"
                        android:text="@string/dashboard_view_all" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExpiringSoon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/home_pad_negative"
                    android:layout_marginBottom="-12dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/home_pad"
                    android:paddingTop="2dp"
                    android:paddingBottom="14dp" />

                <LinearLayout
                    android:id="@+id/tvEmptyExpiring"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_glass_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_home_empty_circle"
                        android:importantForAccessibility="no"
                        android:padding="14dp"
                        android:src="@drawable/ic_calendar_check2"
                        app:tint="@color/home_mint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/cairo_medium"
                        android:includeFontPadding="false"
                        android:text="@string/dashboard_empty_expiring_title"
                        android:textColor="@color/home_mint"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/cairo_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/dashboard_empty_expiring_subtitle"
                        android:textColor="@color/home_mute"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ============ لم يدفعوا بعد ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HomeSectionTitle"
                        android:text="@string/dashboard_unpaid_section" />

                    <TextView
                        android:id="@+id/tvUnpaidSectionCount"
                        style="@style/HomeSectionCount"
                        android:background="@drawable/bg_home_count_coral"
                        android:textColor="@color/home_coral"
                        android:visibility="gone"
                        tools:text="7"
                        tools:visibility="visible" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnViewAllUnpaid"
                        style="@style/HomeViewAll"
                        android:text="@string/dashboard_view_all" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardUnpaidList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_glass_card"
                    android:orientation="vertical"
                    android:paddingVertical="2dp">

                    <LinearLayout
                        android:id="@+id/listUnpaid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvEmptyUnpaid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_glass_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_home_empty_circle"
                        android:importantForAccessibility="no"
                        android:padding="14dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/home_mint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/cairo_medium"
                        android:includeFontPadding="false"
                        android:text="@string/dashboard_empty_unpaid_title"
                        android:textColor="@color/home_mint"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/cairo_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/dashboard_empty_unpaid_subtitle"
                        android:textColor="@color/home_mute"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.gympro.manager.ui.widgets.MaxWidthFrameLayout>
    </ScrollView>

    <!-- هيكل التحميل (Skeleton) بنفس أشكال التصميم: رأس + Hero 272dp + شريط + بطاقة قائمة -->
    <ScrollView
        android:id="@+id/skeletonDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:visibility="gone">

        <com.gympro.manager.ui.widgets.MaxWidthFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/home_pad"
                android:paddingTop="16dp"
                android:paddingBottom="@dimen/home_bottom_extra">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_home_glass_circle" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_home_skeleton" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="272dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_home_skeleton_hero" />

                <View
                    android:layout_width="170dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_home_skeleton" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="142dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_home_skeleton" />

                    <View
                        android:layout_width="142dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_home_skeleton" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_skeleton" />
                </LinearLayout>

                <View
                    android:layout_width="150dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_home_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="@drawable/bg_home_skeleton" />
            </LinearLayout>
        </com.gympro.manager.ui.widgets.MaxWidthFrameLayout>
    </ScrollView>

</FrameLayout>
