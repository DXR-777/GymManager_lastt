<?xml version="1.0" encoding="utf-8"?>
<!--
    بطاقة العضو (إعادة تصميم 2026، نفس لغة الشاشة الرئيسية): صف الهوية (أفاتار + اسم + رقم
    + زر واتساب)، صف الحالة (نوع الاشتراك + الدفع + الأيام المتبقية)، ثم شريط تقدّم رفيع
    بلون الحالة. كل المعرِّفات القديمة محفوظة (cardRoot, tvInitial, tvName, tvPhone,
    tvTypeBadge, tvPaymentBadge, tvDaysRemaining, btnWhatsapp) + الجديد: progressDays.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_home_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInitial"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_home_avatar"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/home_ink"
            android:textSize="18sp"
            tools:text="م" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/home_ink"
                android:textSize="16sp"
                tools:text="محمد أحمد" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/home_mute" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/home_mute"
                    android:textDirection="ltr"
                    android:textSize="13sp"
                    tools:text="0599999999" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnWhatsapp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_members_wa_button"
            android:contentDescription="@string/detail_action_whatsapp"
            android:padding="12dp"
            android:src="@drawable/ic_whatsapp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_chip"
            android:includeFontPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/home_mute"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="شهري" />

        <TextView
            android:id="@+id/tvPaymentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_pill_mint"
            android:includeFontPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/home_mint"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="مدفوع" />

        <TextView
            android:id="@+id/tvDaysRemaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/home_mint"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="باقي 5 يوم" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:max="100"
        app:indicatorColor="@color/home_mint"
        app:trackColor="@color/home_progress_track"
        app:trackCornerRadius="3dp"
        app:trackThickness="5dp"
        tools:progress="60" />

</LinearLayout>
