<?xml version="1.0" encoding="utf-8"?>
<!--
    ورقة تفعيل التنبيهات (مختصرة وواقعية): جرس ممتلئ يهتز بلا دوائر حوله، عنوان وسطر واحد، فائدتان حقيقيتان،
    زر "تفعيل التنبيهات" بسطر واحد، و"ليس الآن". الخلفية تدرّج ينتهي بلون التطبيق ويلتحم مع شريط التنقّل.
    لا بيانات افتراضية ولا معاينات مختلَقة.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_sheet"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/notifContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_home_grabber"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/notifHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/notifBell"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notif_bell_filled" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/cairo_extrabold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/notif_primer_title"
            android:textColor="@color/home_ink"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/cairo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/notif_primer_subtitle"
            android:textColor="@color/home_mute"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_sort_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_ds_clock"
                app:tint="@color/home_lav" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_bold"
                    android:includeFontPadding="false"
                    android:text="@string/notif_primer_b1_title"
                    android:textColor="@color/home_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/cairo_regular"
                    android:includeFontPadding="false"
                    android:text="@string/notif_primer_b1_desc"
                    android:textColor="@color/home_mute"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_sort_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_ds_receipt"
                app:tint="@color/home_coral" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_bold"
                    android:includeFontPadding="false"
                    android:text="@string/notif_primer_b2_title"
                    android:textColor="@color/home_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/cairo_regular"
                    android:includeFontPadding="false"
                    android:text="@string/notif_primer_b2_desc"
                    android:textColor="@color/home_mute"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNotifAllow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_home_cta"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineSpotShadowColor="@color/home_fab_glow">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ds_bell"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="none"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/notif_primer_allow"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnNotifLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/ripple_home_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/cairo_regular"
            android:includeFontPadding="false"
            android:paddingHorizontal="22dp"
            android:paddingVertical="13dp"
            android:text="@string/notif_primer_later"
            android:textColor="@color/home_mute"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
