<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:tag="nav_inset_target"
    android:clipToPadding="false"
    android:fillViewport="true">

    <com.gympro.manager.ui.widgets.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- رأس الشاشة: عنوان + شارة أيقونة accent بمقاس icon_badge_size (نفس نمط رأس
             شاشة إضافة/تعديل عضو المرجعية)؛ مؤشر التحميل الصغير بينهما كما كان. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title" />

            <ProgressBar
                android:id="@+id/progressSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:indeterminateTint="@color/brand_accent"
                android:visibility="gone" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/brand_accent"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_settings"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- معلومات النادي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_gym_info" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:backgroundTint="@color/brand_accent"
                    android:padding="7dp"
                    android:src="@drawable/ic_home"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGymName" style="@style/Widget.GymManager.TextInputLayout.Glass"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_header_gap"
                android:hint="@string/setup_gym_name_label">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGymName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" android:maxLength="60" android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- عملة: حقل غير قابل للكتابة المباشرة عمداً — يفتح منتقي العملة (3 عملات
                 جاهزة ILS/USD/JOD + خيار "عملة أخرى" حرّ عبر حوار مخصّص، راجع البند 23)
                 بدل السماح بطباعة حرّة داخل هذا الحقل نفسه قد تكسر تنسيق الأسعار لاحقاً.
                 راجع showCurrencyPicker() و showCustomCurrencyDialog(). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCurrency" style="@style/Widget.GymManager.TextInputLayout.Glass"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/setup_currency_label"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_chevron_down"
                app:endIconTint="@color/text_secondary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCurrency" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:focusable="false" android:clickable="true" android:cursorVisible="false"
                    android:inputType="none" android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- الأسعار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_pricing" />

                <ImageView
                    android:importantForAccessibility="no"
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_badge"
                    android:backgroundTint="@color/brand_accent"
                    android:padding="7dp"
                    android:src="@drawable/ic_money"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDailyPrice" style="@style/Widget.GymManager.TextInputLayout.Glass"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_header_gap"
                android:hint="@string/setup_price_daily">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDailyPrice" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal" android:maxLength="10" android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWeeklyPrice" style="@style/Widget.GymManager.TextInputLayout.Glass"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/setup_price_weekly">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWeeklyPrice" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal" android:maxLength="10" android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMonthlyPrice" style="@style/Widget.GymManager.TextInputLayout.Glass"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/setup_price_monthly">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMonthlyPrice" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal" android:maxLength="10" android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ===================== نطاق التعديل (Settings Part — واتساب/الإشعارات/حفظ): بداية =====================
             Dark Glassmorphism 2026: الحاويتان تحوَّلتا من bg_card (سطح مصمت) إلى
             bg_card_glass (نفس الخلفية الزجاجية شبه الشفافة + الحد العلوي الناعم
             المستخدمة أعلاه في بطاقتَي "معلومات النادي"/"الأسعار")، لتتوحّد الهوية
             البصرية عبر الشاشة كاملة. لا تغيير على rgWhatsappPrefix ولا أي RadioButton/
             Switch من حيث النوع أو المعرّف — تحسين بصري بحت (لون نص أساسي بدل ثانوي
             لقراءة أوضح على الزجاج الداكن + مساحة لمس مريحة 44dp + تباعد أنيق بين
             الخيارات). -->

        <!-- واتساب -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:layout_marginBottom="@dimen/spacing_header_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_whatsapp" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/brand_accent"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_phone"
                app:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <RadioGroup android:id="@+id/rgWhatsappPrefix" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbPrefixAuto" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:paddingStart="@dimen/spacing_sm" android:textColor="@color/text_primary" android:buttonTint="@color/brand_accent" android:text="@string/whatsapp_prefix_auto" />
                <!-- البند 4: النص يُضبَط برمجياً (SettingsFragment.applyWhatsappPrefixLabels)
                     من نفس مورد onboarding_prefix_*_label/_code المستخدم في شاشة الإعداد
                     الأولي، بدل تكرار "فلسطين +970"/"إسرائيل +972" حرفياً هنا كنص XML ثابت. -->
                <RadioButton android:id="@+id/rbPrefix970" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:minHeight="44dp" android:paddingStart="@dimen/spacing_sm" android:textColor="@color/text_primary" android:buttonTint="@color/brand_accent" />
                <RadioButton android:id="@+id/rbPrefix972" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:minHeight="44dp" android:paddingStart="@dimen/spacing_sm" android:textColor="@color/text_primary" android:buttonTint="@color/brand_accent" />
            </RadioGroup>
        </LinearLayout>

        <!-- الإشعارات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:layout_marginBottom="@dimen/spacing_header_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_notifications" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/brand_accent"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_notification"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- البند 20: لو رفض المستخدم إذن الإشعارات (أو عطّلها لاحقاً من إعدادات النظام)،
             كانت مفاتيح "تنبيه الانتهاء/غير المدفوع" تبقى قابلة للتفعيل دون أي مؤشر بأن
             الإشعارات معطّلة فعلياً على مستوى النظام، فيظن صاحب النادي أن التنبيهات ستصله
             بينما هي مكتومة بالكامل. يظهر هذا الشريط فقط عند التعطيل الفعلي (مرئي/مخفي من
             الكود في SettingsFragment). -->
        <LinearLayout
            android:id="@+id/containerNotificationsDisabledWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:background="@drawable/bg_warning_banner"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:textColor="@color/text_primary"
                    android:text="@string/settings_notifications_disabled_warning" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenNotificationSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/settings_open_notification_settings"
                android:textColor="@color/status_warning" />

        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_glass"
        android:elevation="@dimen/elevation_card_resting" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/spacing_md">
            <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:text="@string/settings_notify_expiry" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchNotifyExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/white" app:trackTint="@color/switch_track_color" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:background="@drawable/bg_card_glass"
        android:elevation="@dimen/elevation_card_resting" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/spacing_md">
            <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:text="@string/settings_notify_unpaid" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchNotifyUnpaid" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/white" app:trackTint="@color/switch_track_color" />
        </LinearLayout>

        <!-- زر الحفظ: من لون مصمت واحد (brand_accent) إلى نفس تدرّج bg_button_gradient
             المعتمَد فعلياً في الشاشات الأخرى (fragment_revenue.xml / activity_add_edit_member.xml)
             لإبراز أكبر كإجراء أساسي — لا تبعية جديدة ولا Drawable جديد، إعادة استخدام
             لِما هو موجود بالفعل بنفس النمط الحرفي. -->
        <FrameLayout
            android:id="@+id/frameSaveSettingsGlow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:background="@drawable/bg_button_glow"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                style="@style/Widget.GymManager.Button.CTA"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_cta"
                android:text="@string/action_save" />
        </FrameLayout>

        <!-- ===================== نطاق التعديل (Settings Part — واتساب/الإشعارات/حفظ): نهاية ===================== -->

        <!-- ===================== الأمان: قفل التطبيق (PIN + بصمة) — راجع security/AppLockManager.kt =====================
             هذه الإعدادات تُطبَّق فوراً (لا تمرّ بزر "حفظ") لأن كل تغيير فيها يمرّ بمصادقة/تأكيد. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:layout_marginBottom="@dimen/spacing_header_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_security" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/brand_accent"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_lock" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="@string/settings_app_lock" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_app_lock_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAppLock" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/white" app:trackTint="@color/switch_track_color" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerAppLockOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="@dimen/spacing_sm" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvBiometricLabel" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:text="@string/settings_biometric" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchBiometric" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/white" app:trackTint="@color/switch_track_color" />
                </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="@dimen/spacing_sm" android:background="@color/divider" />
                <LinearLayout
                    android:id="@+id/rowAutoLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">
                    <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:text="@string/settings_auto_lock" />
                    <TextView android:id="@+id/tvAutoLockValue" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_accent" />
                </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="@dimen/spacing_sm" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="@string/settings_secure_screen" />
                        <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_secure_screen_desc" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchSecureScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/white" app:trackTint="@color/switch_track_color" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePin"
                    style="@style/Widget.GymManager.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/settings_change_pin"
                    app:strokeColor="@color/glass_border_strong" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewRecovery"
                    style="@style/Widget.GymManager.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_new_recovery"
                    app:strokeColor="@color/glass_border_strong" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== نطاق التعديل (Settings Part — البيانات والنسخ الاحتياطي): بداية =====================
             Dark Glassmorphism 2026: الحاويتان تحوَّلتا من bg_card (سطح مصمت) إلى
             bg_card_glass (نفس الخلفية الزجاجية شبه الشفافة المستخدمة في بطاقتَي
             "معلومات النادي"/"الأسعار" وقسم واتساب/الإشعارات أعلاه)، لتتوحّد الهوية
             البصرية عبر الشاشة كاملة. الأزرار الخمسة أبقت على Widget.GymManager.Button.Outlined
             نفسه (مشترك مع بطاقة تأكيد الحذف خارج نطاقي، فلم أعدّل الـ style العام)، مع
             تخصيص محلي على كل زر: app:strokeColor إلى glass_border_strong بدل divider
             المصمت كي يتماشى الحد مع سطح الزجاج الداكن. لا تغيير على المعرّفات أو
             ترتيب/منطق الأزرار (btnBackupNow, btnRestoreBackup, btnExportCsv,
             btnOpenArchive, btnAbout). -->

        <!-- البيانات والنسخ الاحتياطي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:layout_marginBottom="@dimen/spacing_header_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_data" />

            <ImageView
                android:layout_width="@dimen/icon_badge_size"
                android:layout_height="@dimen/icon_badge_size"
                android:background="@drawable/bg_icon_badge"
                android:backgroundTint="@color/brand_accent"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_backup"
                app:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackupNow" style="@style/Widget.GymManager.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:icon="@drawable/ic_backup" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_sm" app:iconTint="@color/text_primary"
                app:strokeColor="@color/glass_border_strong"
                android:text="@string/settings_backup_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreBackup" style="@style/Widget.GymManager.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm"
                app:icon="@drawable/ic_restore" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_sm" app:iconTint="@color/text_primary"
                app:strokeColor="@color/glass_border_strong"
                android:text="@string/settings_restore_backup" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv" style="@style/Widget.GymManager.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm"
                app:icon="@drawable/ic_export" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_sm" app:iconTint="@color/text_primary"
                app:strokeColor="@color/glass_border_strong"
                android:text="@string/settings_export_excel" />

            <!-- البند 26: لم يكن يوجد أي شريط تقدّم فعلي أثناء النسخ الاحتياطي/الاستعادة
                 لملفات كبيرة — فقط progressSettings عام (دوّار 22dp) بلا نسبة أو حجم،
                 فيبقى صاحب النادي بلا أي فكرة هل العملية عالقة أم تتقدّم فعلاً مع
                 مئات الأعضاء/الاشتراكات. الآن شريط تقدّم حقيقي (نسبة مئوية محددة، لا
                 دوّار غير محدد) + نص "المعالَج/الإجمالي" + حجم الملف الناتج بعد
                 الانتهاء. مخفي افتراضياً، يظهر فقط أثناء النسخ الاحتياطي/الاستعادة/
                 التصدير تحديداً (لا عند حفظ الإعدادات البسيط الذي يبقى يستخدم
                 progressSettings الدوّار الصغير كما هو). -->
            <LinearLayout
                android:id="@+id/containerBackupProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBackupDeterminate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_subscription_glass" />

                <TextView
                    android:id="@+id/tvBackupProgressDetail"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    tools:text="45% — 120 من 265" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_card_glass"
            android:elevation="@dimen/elevation_card_resting"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenArchive" style="@style/Widget.GymManager.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:icon="@drawable/ic_archive" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_sm" app:iconTint="@color/text_primary"
                app:strokeColor="@color/glass_border_strong"
                android:text="@string/settings_archive" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbout" style="@style/Widget.GymManager.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm"
                app:icon="@drawable/ic_info" app:iconGravity="textStart" app:iconPadding="@dimen/spacing_sm" app:iconTint="@color/text_primary"
                app:strokeColor="@color/glass_border_strong"
                android:text="@string/settings_about" />
        </LinearLayout>

        <!-- ===================== نطاق التعديل (Settings Part — البيانات والنسخ الاحتياطي): نهاية ===================== -->

        <View android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl" />

    </LinearLayout>
    </com.gympro.manager.ui.widgets.MaxWidthFrameLayout>

</ScrollView>
