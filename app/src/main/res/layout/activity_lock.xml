<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة قفل التطبيق — راجع security/LockActivity.kt. لوحة الأرقام LTR عمداً حتى في واجهة RTL. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_xl">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_icon_badge"
            android:backgroundTint="@color/brand_accent"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/ic_lock" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:minLines="2"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layoutDirection="ltr"
            android:orientation="horizontal">
            <View
                android:id="@+id/dot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_pin_dot" />
            <View
                android:id="@+id/dot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_pin_dot" />
            <View
                android:id="@+id/dot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_pin_dot" />
            <View
                android:id="@+id/dot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_pin_dot" />
            <View
                android:id="@+id/dot5"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_pin_dot" />
            <View
                android:id="@+id/dot6"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_pin_dot" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="252dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layoutDirection="ltr"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView
                    android:id="@+id/key1"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="1" />
                <TextView
                    android:id="@+id/key2"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="2" />
                <TextView
                    android:id="@+id/key3"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="3" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView
                    android:id="@+id/key4"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="4" />
                <TextView
                    android:id="@+id/key5"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="5" />
                <TextView
                    android:id="@+id/key6"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="6" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView
                    android:id="@+id/key7"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="7" />
                <TextView
                    android:id="@+id/key8"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="8" />
                <TextView
                    android:id="@+id/key9"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="9" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageView
                    android:id="@+id/keyBiometric"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_keypad_key_flat"
                    android:contentDescription="@string/lock_biometric_title"
                    android:padding="22dp"
                    android:src="@drawable/ic_fingerprint" />
                <TextView
                    android:id="@+id/key0"
                    style="@style/Widget.GymManager.KeypadKey"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:text="0" />
                <ImageView
                    android:id="@+id/keyBackspace"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_keypad_key_flat"
                    android:contentDescription="@string/lock_backspace"
                    android:padding="22dp"
                    android:src="@drawable/ic_backspace" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvForgot"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/lock_forgot"
            android:textColor="@color/brand_accent" />

    </LinearLayout>
</ScrollView>
