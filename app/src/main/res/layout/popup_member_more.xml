<?xml version="1.0" encoding="utf-8"?>
<!-- قائمة "المزيد" في شاشة العضو: بطاقة زجاجية صغيرة بصفّين (تعديل / حذف) مع أيقونات نغمية. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/menuCard"
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pd_menu"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/menuEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pd_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pd_action_lav"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_pd_edit"
                app:tint="@color/home_lav" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/detail_action_edit"
                android:textColor="@color/home_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="2dp"
            android:background="#14FFFFFF"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/menuDelete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pd_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pd_action_coral"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_pd_trash"
                app:tint="@color/home_coral" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/detail_action_delete"
                android:textColor="@color/home_coral"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
