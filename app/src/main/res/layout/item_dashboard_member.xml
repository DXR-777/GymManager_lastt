<?xml version="1.0" encoding="utf-8"?>
<!--
    بطاقة عضو في شريط "ينتهي اشتراكهم قريباً" — مطابقة لـ .m في تصميم HTML:
    عرض 142dp، أفاتار 48dp بحلقة متدرّجة، الاسم، نوع الاشتراك، ثم شارة الأيام المتبقية.
    الألوان ثابتة داكنة (home_*) لأن الشاشة الرئيسية داكنة دائماً.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="142dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_home_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_home_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/tvInitial"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_home_avatar"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/home_ink"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="ف" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/home_ink"
        android:textSize="14.5sp"
        android:textStyle="bold"
        tools:text="فيصل الشمري" />

    <TextView
        android:id="@+id/tvPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/home_mute"
        android:textSize="12sp"
        tools:text="اشتراك شهري" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_pill_amber"
        android:fontFamily="@font/cairo_medium"
        android:includeFontPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textColor="@color/home_amber"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="بعد يومين" />

</LinearLayout>
