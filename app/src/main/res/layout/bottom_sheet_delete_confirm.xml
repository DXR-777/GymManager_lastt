<?xml version="1.0" encoding="utf-8"?>
<!--
    ورقة تأكيد حذف العضو: نفس هوية نافذة الدفع (سطح داكن + توهج لوني علوي + أيقونة بدائرة نغمية)،
    لكن بنبرة مرجانية لأن الحذف عملية خطرة. المعرِّفات القديمة محفوظة كلها.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pd_sheet_danger"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_home_grabber"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pd_action_coral"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/ic_pd_trash"
        app:tint="@color/home_coral" />

    <TextView
        android:id="@+id/tvDeleteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/cairo_extrabold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/delete_dialog_title"
        android:textColor="@color/home_ink"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvDeleteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/cairo_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/home_mute"
        android:textSize="14sp"
        tools:text="سينتقل إلى الأرشيف ويمكنك استعادته خلال 30 يوماً" />

    <TextView
        android:id="@+id/tvBalanceWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pd_warn_coral"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_pd_alert"
        android:drawableTint="@color/home_coral"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center_vertical|start"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/home_coral"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="تنبيه: على هذا العضو مبلغ غير مدفوع وقدره 60 ₪" />

    <TextView
        android:id="@+id/tvDaysWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pd_warn_amber"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/ic_pd_alert"
        android:drawableTint="@color/home_amber"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center_vertical|start"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/home_amber"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="تنبيه: لا يزال للعضو 12 يوم متبقي من اشتراكه الحالي" />

    <TextView
        android:id="@+id/btnConfirmDelete"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pd_cta_coral"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_extrabold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/delete_dialog_confirm"
        android:textColor="@color/home_bg"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnCancelDelete"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pd_btn_outline"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/action_cancel"
        android:textColor="@color/home_ink"
        android:textSize="15sp" />
</LinearLayout>
