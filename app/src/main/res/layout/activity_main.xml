<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- توهج خلفي (4.1): خلف الرأس والمحتوى العلوي ليعطي الزجاج ما يُقرأ خلفه -->
    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@drawable/bg_screen_glow"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <!--
            رأس الشاشات الرئيسية: نفس مواصفات الرأس المرجعي في activity_add_edit_member.xml
            (ارتفاع actionBarSize، عنوان Text.Title بالمنتصف على خلفية background) —
            MaterialToolbar بدل androidx Toolbar لأن العنوان المتمركز (titleCentered) لا يتوفر إلا
            فيه، وهو يبقى Toolbar فعلياً (setSupportActionBar وقائمة sort/archive في
            MembersFragment تعتمدان على ذلك، فلا يمكن استبداله بـ LinearLayout كما في
            الشاشات الثانوية).
        -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent"
            app:title="@string/app_name"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Text.Title"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_lg"
        android:visibility="gone"
        android:contentDescription="@string/add_member_title"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/fab_add_member_background_color"
        app:rippleColor="@color/ripple_on_dark"
        app:tint="@color/white"
        app:elevation="@dimen/elevation_fab"
        app:pressedTranslationZ="@dimen/elevation_button_press_lift"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.GymManager.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_nav_glass"
        app:elevation="12dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
