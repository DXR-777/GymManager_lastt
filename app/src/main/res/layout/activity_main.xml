<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- توهج خلفي (4.1): خلف الرأس والمحتوى العلوي ليعطي الزجاج ما يُقرأ خلفه -->
    <View
        android:id="@+id/screenGlow"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@drawable/bg_screen_glow"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <!--
            رأس الشاشات الرئيسية: نفس مواصفات الرأس المرجعي في activity_add_edit_member.xml
            (ارتفاع actionBarSize، عنوان Text.Title بالمنتصف على خلفية background) —
            MaterialToolbar بدل androidx Toolbar لأن العنوان المتمركز (titleCentered) لا يتوفر إلا
            فيه، وهو يبقى Toolbar فعلياً (setSupportActionBar وقائمة sort/archive في
            MembersFragment تعتمدان على ذلك، فلا يمكن استبداله بـ LinearLayout كما في
            الشاشات الثانوية).
        -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent"
            app:title="@string/app_name"
            app:titleCentered="true"
            app:titleTextAppearance="@style/Text.Title"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        الشريط السفلي حرفياً كما في تصميم HTML (.dock): حبّة زجاجية بأربع أيقونات (64dp) + زر إضافة دائري
        منفصل (64dp) بفجوة 12dp، عرض أقصى 430dp. الزر العائم يُخفى في الإيرادات والإعدادات فيتمدّد الشريط.
    -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="430dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.GymManager.BottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_nav_pill"
            android:elevation="10dp"
            android:paddingHorizontal="8dp"
            app:elevation="10dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:menu="@menu/bottom_nav_menu" />

        <ImageButton
            android:id="@+id/fabAddMember"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_home_fab"
            android:contentDescription="@string/add_member_title"
            android:elevation="8dp"
            android:outlineSpotShadowColor="@color/home_fab_glow"
            android:scaleType="center"
            android:src="@drawable/ic_ds_plus"
            android:visibility="gone"
            app:tint="@color/white"
            tools:targetApi="p" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
