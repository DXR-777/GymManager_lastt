<?xml version="1.0" encoding="utf-8"?>
<!-- ورقة "تجديد الاشتراك": بنفس باقة العضو السابقة، البدء تلقائي بعد انتهاء الحالي (تمديد متتالي). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pd_sheet_pay">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_home_grabber" android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_pd_action_mint" android:importantForAccessibility="no"
            android:padding="12dp" android:src="@drawable/ic_pd_calendar" app:tint="@color/home_mint" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_extrabold" android:gravity="start" android:includeFontPadding="false"
                android:text="@string/renew_member_title" android:textColor="@color/home_ink" android:textSize="19sp" />
            <TextView android:id="@+id/tvRenewSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:fontFamily="@font/cairo_regular" android:gravity="start"
                android:includeFontPadding="false" android:textColor="@color/home_mute" android:textSize="13sp"
                tools:text="سوا · ينتهي الحالي 23 ديسمبر" />
        </LinearLayout>
    </LinearLayout>

    <!-- الباقة + المدة في بطاقة واحدة -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:background="@drawable/bg_pd_receipt"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvRenewPlan" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="@font/cairo_bold" android:gravity="start"
                android:includeFontPadding="false" android:textColor="@color/home_ink" android:textSize="16sp"
                tools:text="شهري" />
            <TextView android:id="@+id/tvRenewPrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_extrabold" android:includeFontPadding="false"
                android:textColor="@color/home_mint" android:textSize="24sp" tools:text="₪ 50" />
        </LinearLayout>
        <TextView android:id="@+id/tvRenewRange" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:fontFamily="@font/cairo_bold" android:gravity="start"
            android:includeFontPadding="false" android:textColor="@color/home_ink" android:textSize="14sp"
            tools:text="24 ديسمبر ← 23 يناير 2027" />
        <TextView android:id="@+id/tvRenewNote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:fontFamily="@font/cairo_regular" android:gravity="start"
            android:includeFontPadding="false" android:textColor="@color/home_mute" android:textSize="12sp"
            tools:text="يبدأ بعد انتهاء الحالي مباشرةً — لا يضيع أي يوم" />
        <TextView android:id="@+id/btnRenewChange" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true" android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false" android:paddingVertical="4dp"
            android:text="@string/renew_sheet_change_plan" android:textColor="@color/home_lav" android:textSize="13sp" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:fontFamily="@font/cairo_bold" android:gravity="start"
        android:includeFontPadding="false" android:text="@string/renew_sheet_pay_title"
        android:textColor="@color/home_ink" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/rnPayNow" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@drawable/bg_pd_sort_row" android:clickable="true" android:focusable="true" android:fontFamily="@font/cairo_bold" android:gravity="center" android:includeFontPadding="false" android:text="@string/renew_sheet_pay_now" android:textColor="@color/home_mute" android:textSize="14sp" />
        <Space android:layout_width="10dp" android:layout_height="0dp" />
        <TextView android:id="@+id/rnPayLater" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@drawable/bg_pd_sort_row" android:clickable="true" android:focusable="true" android:fontFamily="@font/cairo_bold" android:gravity="center" android:includeFontPadding="false" android:text="@string/renew_sheet_pay_later" android:textColor="@color/home_mute" android:textSize="14sp" />
    </LinearLayout>

    <include android:id="@+id/renewPicker" layout="@layout/include_payment_picker" android:visibility="gone" />

    <TextView android:id="@+id/tvRenewSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:fontFamily="@font/cairo_regular" android:gravity="start"
        android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:textColor="@color/home_mute" android:textSize="12sp" />

    <TextView android:id="@+id/btnRenewConfirm" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="14dp" android:background="@drawable/bg_home_cta" android:clickable="true"
        android:focusable="true" android:fontFamily="@font/cairo_bold" android:gravity="center"
        android:includeFontPadding="false" android:text="@string/renew_sheet_confirm"
        android:textColor="@color/home_ink" android:textSize="16sp" />

    <TextView android:id="@+id/btnRenewCancel" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="6dp" android:background="?attr/selectableItemBackground" android:clickable="true"
        android:focusable="true" android:fontFamily="@font/cairo_bold" android:gravity="center"
        android:includeFontPadding="false" android:text="@string/action_cancel"
        android:textColor="@color/home_mute" android:textSize="15sp" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
