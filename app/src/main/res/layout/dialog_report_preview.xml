<?xml version="1.0" encoding="utf-8"?>
<!--
    معاينة التقرير قبل المشاركة (البند 31) — إعادة تصميم 2026 بنفس ورقة الرئيسية الزجاجية (bg_home_sheet):
    مقبض + ترويسة (بلاطة + عنوان + تلميح) + «ورقة التقرير» زجاجية قابلة للتمرير والتحديد + زر مشاركة
    بنمط bg_home_cta + إلغاء نصّي. يُعرض داخل BottomSheetDialog (RevenueFragment.showReportPreview).
    المعرّفات القديمة (tvReportPreviewHint / tvReportPreviewContent) محفوظة كما هي.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_sheet"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_home_grabber"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/rev_bg_tile_lav"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_pd_share"
            app:tint="@color/home_lav" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReportPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_extrabold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/revenue_report_preview_title"
                android:textColor="@color/home_ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvReportPreviewHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/cairo_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/revenue_report_preview_hint"
                android:textColor="@color/home_mute"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ورقة التقرير: بطاقة زجاجية بنفس نصف قطر 24dp؛ الارتفاع يُقيَّد برمجياً (maxHeight غير مدعوم في ScrollView) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReportPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_home_glass_card"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvReportPreviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_medium"
            android:fontFeatureSettings="tnum"
            android:gravity="start"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:padding="16dp"
            android:textColor="@color/home_ink"
            android:textIsSelectable="true"
            android:textSize="13sp"
            tools:text="نادي المثال — الإيرادات والأرباح" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnReportPreviewShare"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_home_cta"
        android:clickable="true"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_pd_share"
        android:drawableTint="@color/white"
        android:elevation="8dp"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:outlineAmbientShadowColor="@android:color/transparent"
        android:outlineSpotShadowColor="@color/home_fab_glow"
        android:paddingHorizontal="20dp"
        android:text="@string/revenue_report_preview_action_share"
        android:textColor="@color/white"
        android:textSize="15sp"
        tools:targetApi="p" />

    <TextView
        android:id="@+id/btnReportPreviewCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="48dp"
        android:text="@string/revenue_report_preview_action_cancel"
        android:textColor="@color/home_mute"
        android:textSize="14sp" />

</LinearLayout>
