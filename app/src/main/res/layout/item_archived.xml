<?xml version="1.0" encoding="utf-8"?>
<!--
    بطاقة عضو محذوف (تحسين UX 2026): هوية العضو + تاريخ الحذف + شارة الدَّين، ثم مؤقّت الحذف النهائي
    كشريط تقدّم بلون الإلحاح (أخضر ← كهرماني ← مرجاني)، ثم زرّان بنصّ واضح ومفصولان: "استعادة" (الأساسي)
    و"حذف نهائي" (الثانوي الخطِر) — بدل أيقونتين متجاورتين بلا نص. المعرِّفات القديمة كلها محفوظة.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_glass_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInitial"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_home_avatar"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/home_ink"
            android:textSize="18sp"
            tools:text="م" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/home_ink"
                android:textSize="16sp"
                tools:text="محمد أحمد" />

            <TextView
                android:id="@+id/tvDeletedOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/cairo_regular"
                android:includeFontPadding="false"
                android:textColor="@color/home_mute"
                android:textSize="12sp"
                tools:text="حُذف في 15 يونيو 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDebtBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_pill_coral"
            android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/home_coral"
            android:textSize="11.5sp"
            android:visibility="gone"
            tools:text="دَين مستحق: 150 ₪"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPurgeCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/cairo_bold"
        android:includeFontPadding="false"
        android:textColor="@color/home_mint"
        android:textSize="12sp"
        tools:text="يُحذف نهائياً خلال 28 يوم" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressPurge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:max="100"
        app:indicatorColor="@color/home_mint"
        app:trackColor="@color/home_progress_track"
        app:trackCornerRadius="3dp"
        app:trackThickness="5dp"
        tools:progress="90" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRestore"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_archive_btn_restore"
            android:clickable="true"
            android:drawableStart="@drawable/ic_restore"
            android:drawablePadding="8dp"
            android:drawableTint="@color/home_mint"
            android:focusable="true"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:text="@string/action_restore"
            android:textColor="@color/home_mint"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btnPermanentDelete"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_archive_btn_delete"
            android:clickable="true"
            android:drawableStart="@drawable/ic_delete"
            android:drawablePadding="8dp"
            android:drawableTint="@color/home_coral"
            android:focusable="true"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:text="@string/archive_delete_forever"
            android:textColor="@color/home_coral"
            android:textSize="13.5sp"
            android:layout_marginStart="10dp" />

    </LinearLayout>
</LinearLayout>
