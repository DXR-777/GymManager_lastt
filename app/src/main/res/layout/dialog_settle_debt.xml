<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pd_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- هالة الدفع: محفظة بنبرة نعناعية = مال داخل -->
    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_pd_action_mint"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/ic_pd_wallet"
        app:tint="#6EE7B7" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/cairo_bold"
        android:includeFontPadding="false"
        android:text="@string/settle_debt_confirm_title"
        android:textColor="@color/home_ink"
        android:textSize="19sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/cairo_regular"
        android:includeFontPadding="false"
        android:text="@string/settle_debt_amount_label"
        android:textColor="@color/home_mute"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSettleAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/cairo_extrabold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="#6EE7B7"
        android:textSize="40sp"
        tools:ignore="HardcodedText"
        tools:text="₪ 5" />

    <!-- بطاقة التفاصيل: العضو + الاشتراك -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pd_sort_row"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSettleInitial"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pd_action_lav"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/home_lav"
                android:textSize="15sp"
                tools:text="س" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="@string/settle_debt_from_label"
                    android:textColor="@color/home_mute"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSettleMember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/home_ink"
                    android:textSize="15sp"
                    tools:text="سمير" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#14FFFFFF"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pd_action_sky"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_pd_calendar"
                app:tint="#9CC7FF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettlePlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textColor="@color/home_ink"
                    android:textSize="14sp"
                    tools:text="اشتراك شهري" />

                <TextView
                    android:id="@+id/tvSettleDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/cairo_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textColor="@color/home_mute"
                    android:textSize="12sp"
                    tools:text="22 نوفمبر → 21 ديسمبر 2026" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ملاحظة: أين سيُسجَّل المبلغ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pd_alert"
            app:tint="@color/home_mute" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/cairo_regular"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="@string/settle_debt_note"
            android:textColor="@color/home_mute"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSettleConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_home_cta"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/settle_debt_confirm_action"
        android:textColor="@color/home_ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnSettleCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/action_cancel"
        android:textColor="@color/home_mute"
        android:textSize="15sp" />
</LinearLayout>
