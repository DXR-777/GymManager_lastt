<?xml version="1.0" encoding="utf-8"?>
<!--
    ورقة "تسجيل دفعة": تُفتح عند الضغط على "تسديد". تسديد المتبقي كاملاً فقط (بلا دفع جزئي)،
    بنفس أيقونات طرق الدفع الموجودة في نموذج العضو (ic_pay_*)، مع بيانات المُرسِل للمحافظ والبنك.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pd_sheet_pay"
    android:fillViewport="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_home_grabber"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_pd_action_mint"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_pd_wallet"
            app:tint="@color/home_mint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_extrabold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:text="@string/pay_sheet_title"
                android:textColor="@color/home_ink"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvPaySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/cairo_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textColor="@color/home_mute"
                android:textSize="13sp"
                tools:text="أحمد · اشتراك شهري" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pd_receipt"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cairo_bold"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="@string/pay_sheet_remaining"
            android:textColor="@color/home_mute"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPayAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_extrabold"
            android:includeFontPadding="false"
            android:textColor="@color/home_mint"
            android:textSize="26sp"
            tools:text="₪ 150" />
    </LinearLayout>

    <include layout="@layout/include_payment_picker" />

    <TextView
        android:id="@+id/tvPaySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/cairo_regular"
        android:gravity="start"
        android:includeFontPadding="false"
        android:text="@string/pay_sheet_summary_empty"
        android:textColor="@color/home_mute"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnPayConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_home_cta"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/settle_debt_confirm_action"
        android:textColor="@color/home_ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnPayCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/cairo_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/action_cancel"
        android:textColor="@color/home_mute"
        android:textSize="15sp" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
