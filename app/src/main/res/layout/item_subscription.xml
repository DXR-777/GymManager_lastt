<?xml version="1.0" encoding="utf-8"?>
<!--
    عنصر سجل الاشتراك كمدخل في خط زمني: خط رفيع + نقطة متوهجة بلون الحالة (تُلوَّن برمجياً)،
    وبطاقة زجاجية: الخطة · الشارة، المدى الزمني، المبلغ · طريقة الدفع، وللجزئي "المتبقي" + شريط،
    وزر "تسديد" للجزئي وغير المدفوع. الفراغ بين البطاقات حشوة سفلية (لا margin) ليبقى الخط متصلاً.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|top"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_detail_line"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/dotTimeline"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_detail_dot"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:background="@drawable/bg_detail_card"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSubType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:textColor="@color/home_ink"
                android:textSize="15sp"
                tools:text="مدة مخصصة" />

            <TextView
                android:id="@+id/tvSubPaid"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_detail_pill_mint"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="10dp"
                android:textColor="@color/home_mint"
                android:textSize="12sp"
                tools:text="مدفوع" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/cairo_regular"
            android:includeFontPadding="false"
            android:textColor="@color/home_mute"
            android:textSize="13sp"
            tools:text="12 نوفمبر 2026 ← 16 نوفمبر 2026" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSubPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_extrabold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="@color/home_ink"
                android:textSize="22sp"
                tools:text="₪10" />

            <TextView
                android:id="@+id/tvSubPaymentMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_pd_wallet"
                android:drawablePadding="6dp"
                android:drawableTint="@color/home_mute"
                android:fontFamily="@font/cairo_regular"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/home_mute"
                android:textSize="13sp"
                tools:text="بال باي" />
        </LinearLayout>

        <!-- لا يُعرض إطلاقاً في السجل المختصر (راجع SubscriptionHistoryAdapter) -->
        <TextView
            android:id="@+id/tvSubSenderInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbSubPaid"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progressDrawable="@drawable/progress_detail_status"
            android:progressTint="@color/home_lav"
            android:visibility="gone"
            tools:progress="50"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/rowSubAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvSubRemaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:textColor="@color/home_lav"
                android:textSize="13sp"
                tools:text="المتبقي: ₪5" />

            <!-- زر "تسديد": مرئي 40dp داخل منطقة لمس 48dp؛ يظهر للجزئي وغير المدفوع (يضبطه المحوّل). -->
            <TextView
                android:id="@+id/btnSettleDebt"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_detail_pay_inset"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="88dp"
                android:paddingHorizontal="24dp"
                android:text="@string/action_settle_debt"
                android:textColor="@color/detail_on_mint"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
