<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/home_panel_top" android:endColor="@color/home_panel_bottom"/>
        </shape>
    </item>
    <item android:width="1dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_panel_edge"/>
        </shape>
    </item>
</layer-list>
