<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_glass_fill"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke android:width="1dp" android:color="@color/home_glass_stroke"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:start="14dp" android:end="14dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="@color/transparent" android:centerColor="@color/home_glass_top" android:endColor="@color/transparent"/>
        </shape>
    </item>
</layer-list>
