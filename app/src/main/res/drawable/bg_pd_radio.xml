<?xml version="1.0" encoding="utf-8"?>
<!-- زر اختيار دائري: مختار = حلقة لافندر + نقطة داخلية. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#26E4D9FF"/><stroke android:width="2dp" android:color="#E4D9FF"/></shape></item>
            <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="5dp"><shape android:shape="oval"><solid android:color="#E4D9FF"/></shape></item>
        </layer-list>
    </item>
    <item><shape android:shape="oval"><stroke android:width="1.5dp" android:color="#4DFFFFFF"/></shape></item>
</selector>
