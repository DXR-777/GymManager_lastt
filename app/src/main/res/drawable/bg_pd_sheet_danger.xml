<?xml version="1.0" encoding="utf-8"?>
<!-- ورقة الحذف: نفس سطح نافذة الدفع (داكن + حدّ زجاجي) بتوهج مرجاني علوي، بزوايا علوية فقط. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FF15163A"/>
        <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="240dp" android:startColor="#29FFB8B8" android:endColor="#00FFB8B8"/>
        <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/></shape></item>
    <item><shape android:shape="rectangle"><stroke android:width="1dp" android:color="#2EFFFFFF"/>
        <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/></shape></item>
</layer-list>
