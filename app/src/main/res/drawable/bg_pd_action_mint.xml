<?xml version="1.0" encoding="utf-8"?>
<!-- دائرة إجراء بنبرة mint: تعبئة شفافة بلون النبرة + توهج علوي ناعم + حدّ رفيع بنفس النبرة (تُلوَّن الأيقونة بالنبرة نفسها). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#176EE7B7"/></shape></item>
    <item><shape android:shape="oval">
        <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="40dp" android:startColor="#266EE7B7" android:endColor="#006EE7B7"/></shape></item>
    <item><shape android:shape="oval"><stroke android:width="1dp" android:color="#406EE7B7"/></shape></item>
</layer-list>
