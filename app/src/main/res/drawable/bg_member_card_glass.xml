<?xml version="1.0" encoding="utf-8"?>
<!--
    خلفية بطاقة العضو (Dark Glassmorphism 2026): نفس نمط الطبقات الثلاث المستخدم بالفعل
    في bg_bottom_nav_glass.xml (تعبئة شبه شفافة + توهج علوي خافت + حدّ رفيع)، لإعطاء بطاقة
    كل عضو نفس الهوية الزجاجية للتطبيق بدل السطح المصمت bg_card السابق.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_alt" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_border_strong"
                android:centerColor="@color/transparent"
                android:centerY="0.5"
                android:endColor="@color/transparent" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

</layer-list>
