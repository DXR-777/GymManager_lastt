<?xml version="1.0" encoding="utf-8"?>
<!-- ورقة سفلية داكنة بحواف علوية 28dp وحدّ زجاجي رفيع، بنفس هوية الشاشات الجديدة -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F2121330"/>
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke android:width="1dp" android:color="@color/home_glass_stroke"/>
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"/>
        </shape>
    </item>
</layer-list>
