<?xml version="1.0" encoding="utf-8"?>
<!-- دائرة إجراء بنبرة coral: تعبئة شفافة بلون النبرة + توهج علوي ناعم + حدّ رفيع بنفس النبرة (تُلوَّن الأيقونة بالنبرة نفسها). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#17FFB8B8"/></shape></item>
    <item><shape android:shape="oval">
        <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="40dp" android:startColor="#26FFB8B8" android:endColor="#00FFB8B8"/></shape></item>
    <item><shape android:shape="oval"><stroke android:width="1dp" android:color="#40FFB8B8"/></shape></item>
</layer-list>
