<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_alt"/>
            <corners android:radius="@dimen/radius_full"/>
            <stroke android:width="1dp" android:color="@color/glass_border"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/brand_gradient_start"
                    android:endColor="@color/brand_gradient_end" />
                <corners android:radius="@dimen/radius_full"/>
            </shape>
        </clip>
    </item>
</layer-list>
