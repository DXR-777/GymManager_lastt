<?xml version="1.0" encoding="utf-8"?>
<!-- زر ثانوي زجاجي (حدّ رفيع + تعبئة خفيفة): للإجراءات المكرّرة التي لا يجب أن تنافس الإجراء الرئيسي -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_dark">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_btn_secondary_fill"/>
            <stroke android:width="1dp" android:color="@color/home_btn_secondary_stroke"/>
            <corners android:radius="99dp"/>
        </shape>
    </item>
</ripple>
