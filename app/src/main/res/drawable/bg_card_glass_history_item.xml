<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة زجاجية لعناصر "سجل الاشتراكات السابقة": نفس روح bg_card_glass_compact
     (تعبئة glass_fill_alt شبه الشفافة)، لكن بنصف قطر أكبر (radius_lg) وحدّ أوضح
     (glass_border_strong) لأن هذه العناصر تقع مباشرة فوق خلفية الشاشة الداكنة
     (لا فوق بطاقة أخرى كما في البطاقات المصغّرة للإحصائيات)، فتحتاج تعريفاً
     بصرياً أقوى قليلاً لتبرز كعنصر قائمة مستقل. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_fill_alt"/>
    <corners android:radius="@dimen/radius_lg"/>
    <stroke android:width="1dp" android:color="@color/glass_border_strong"/>
</shape>
