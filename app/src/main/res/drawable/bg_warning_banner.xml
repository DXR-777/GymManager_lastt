<?xml version="1.0" encoding="utf-8"?>
<!-- شريط تحذير عام (Dark Glassmorphism 2026) — يُستخدم في شاشة الإعدادات لتنبيه صاحب النادي
     أن إشعارات النظام معطّلة فعلياً لهذا التطبيق (راجع البند 20). نفس نمط الطبقات الثلاث لـ
     bg_banner_error_glass.xml لكن بتلوين "تحذير" (status_warning): 1) تعبئة صفراء شبه
     شفافة، 2) توهج علوي خافت يحاكي انعكاس الضوء، 3) حدّ رفيع بلون التحذير. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/status_warning_bg" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_border_strong"
                android:centerColor="@color/transparent"
                android:centerY="0.55"
                android:endColor="@color/transparent" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="@color/status_warning" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

</layer-list>
