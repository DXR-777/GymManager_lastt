<?xml version="1.0" encoding="utf-8"?>
<!-- دائرة إجراء بنبرة sky: تعبئة شفافة بلون النبرة + توهج علوي ناعم + حدّ رفيع بنفس النبرة (تُلوَّن الأيقونة بالنبرة نفسها). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#179CC7FF"/></shape></item>
    <item><shape android:shape="oval">
        <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="40dp" android:startColor="#269CC7FF" android:endColor="#009CC7FF"/></shape></item>
    <item><shape android:shape="oval"><stroke android:width="1dp" android:color="#409CC7FF"/></shape></item>
</layer-list>
