<?xml version="1.0" encoding="utf-8"?>
<!--
    توهجان ضبابيان خافتان خلف الجزء العلوي من الشاشات: أحمر (glow_accent_softer) وبنفسجي
    (glow_purple_softer). يمنحان الزجاج محتوى يُقرأ خلفه، فتظهر البطاقات كزجاج فعلاً.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="@color/glow_purple_softer"
                android:endColor="@color/transparent" />
        </shape>
    </item>

    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="top|end">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="@color/glow_accent_softer"
                android:endColor="@color/transparent" />
        </shape>
    </item>

</layer-list>
