<?xml version="1.0" encoding="utf-8"?>
<!-- الكرات الضبابية الثلاث خلف الشاشة الرئيسية (.o1 .o2 .o3 في تصميم HTML) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="460dp" android:height="460dp" android:gravity="top|right" android:top="-20dp" android:right="-200dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="221dp" android:centerX="0.5" android:centerY="0.5"
                android:startColor="@color/home_orb1" android:endColor="@color/home_orb1_end"/>
        </shape>
    </item>
    <item android:width="520dp" android:height="520dp" android:gravity="top|left" android:top="440dp" android:left="-260dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="250dp" android:centerX="0.5" android:centerY="0.5"
                android:startColor="@color/home_orb2" android:endColor="@color/home_orb2_end"/>
        </shape>
    </item>
    <item android:width="420dp" android:height="420dp" android:gravity="bottom|right" android:bottom="-200dp" android:right="-100dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="202dp" android:centerX="0.5" android:centerY="0.5"
                android:startColor="@color/home_orb3" android:endColor="@color/home_orb3_end"/>
        </shape>
    </item>
</layer-list>
