<?xml version="1.0" encoding="utf-8"?>
<!-- قائمة المزيد: نفس سطح نوافذ الحوار (داكن + توهج بنفسجي خفيف + حدّ زجاجي) بزوايا 20dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FF181A40"/><corners android:radius="20dp"/></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:centerX="0.9" android:centerY="0.0" android:gradientRadius="180dp" android:startColor="#2E7C4DE8" android:endColor="#007C4DE8"/>
        <corners android:radius="20dp"/></shape></item>
    <item><shape android:shape="rectangle"><stroke android:width="1dp" android:color="#2EFFFFFF"/><corners android:radius="20dp"/></shape></item>
</layer-list>
