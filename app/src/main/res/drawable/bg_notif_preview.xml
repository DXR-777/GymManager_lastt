<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة معاينة إشعار نموذجي: سطح زجاجي أفتح قليلاً مع حدّ رفيع وظلّ لوني خفيف -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#26FFFFFF" android:endColor="#0DFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
