<?xml version="1.0" encoding="utf-8"?>
<!-- نافذة الدفع: نفس سطح نافذة الترتيب لكن بتوهج نعناعي علوي (لون المال الداخل) بدل البنفسجي. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FF15163A"/><corners android:radius="28dp"/></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="230dp" android:startColor="#296EE7B7" android:endColor="#006EE7B7"/>
        <corners android:radius="28dp"/></shape></item>
    <item><shape android:shape="rectangle"><stroke android:width="1dp" android:color="#2EFFFFFF"/><corners android:radius="28dp"/></shape></item>
</layer-list>
