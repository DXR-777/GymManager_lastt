<?xml version="1.0" encoding="utf-8"?>
<!--
    بطاقات الإحصائيات ورأس الشاشة: نفس الطبقات الزجاجية لـ bg_member_card_glass
    (تعبئة + لمعان علوي + حدّ + خط علوي مُبرَز) لكن بلمعان أخفّ (glass_sheen_soft).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_alt" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_sheen_soft"
                android:centerColor="@color/transparent"
                android:centerY="0.5"
                android:endColor="@color/transparent" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <!-- حدّ علوي مُبرَز: خط رفيع متلاشي الأطراف يعوّض غياب الظل على الخلفيات الداكنة -->
    <item
        android:height="1dp"
        android:gravity="top"
        android:start="16dp"
        android:end="16dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/transparent"
                android:centerColor="@color/glass_top_highlight"
                android:endColor="@color/transparent" />
        </shape>
    </item>

</layer-list>
