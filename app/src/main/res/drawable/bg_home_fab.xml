<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_dark">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:type="linear" android:angle="315"
                        android:startColor="@color/home_crim" android:endColor="@color/home_vio"/>
                </shape>
            </item>
            <item android:height="1dp" android:gravity="top" android:start="14dp" android:end="14dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient android:type="linear" android:angle="0"
                        android:startColor="@color/transparent" android:centerColor="#66FFFFFF" android:endColor="@color/transparent"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
