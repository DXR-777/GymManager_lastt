<?xml version="1.0" encoding="utf-8"?>
<!--
    زر الحفظ (Save CTA) — تدقيق التموّج (Ripple QA — 2026): ripple_selectable_dark
    المشترك (يُستخدم أيضاً في شرائح نوع الاشتراك/طريقة الدفع) بلا mask، فيتموّج حتى
    حواف الـ View المستطيلة بلا التفاف حول الزوايا الدائرية لخلفية الزر، ما يُظهر
    "تسرّب" مربّع الشكل خارج حدود الزر المنحني. هذا ملف مخصّص للزر فقط (لا يمسّ
    الملف المشترك) بقناع (mask) يطابق radius_button_cta تماماً.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_dark">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/radius_button_cta" />
        </shape>
    </item>
</ripple>
