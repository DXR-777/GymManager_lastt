<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="48dp" android:height="48dp" android:gravity="center">
                <shape android:shape="oval">
                    <gradient android:type="linear" android:angle="315"
                        android:startColor="@color/home_crim" android:endColor="@color/home_vio"/>
                </shape>
            </item>
            <item android:width="44dp" android:height="44dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/home_nav_active_fill"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
        </shape>
    </item>
</selector>
