        <shape android:shape="oval">
            <solid android:color="@color/brand_accent"/>
            <size android:width="14dp" android:height="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="@color/glass_border_strong"/>
            <size android:width="14dp" android:height="14dp"/>
        </shape>
    </item>
</selector>
