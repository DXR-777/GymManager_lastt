<?xml version="1.0" encoding="utf-8"?>
<!-- دائرة إجراء بنبرة lav: تعبئة شفافة بلون النبرة + توهج علوي ناعم + حدّ رفيع بنفس النبرة (تُلوَّن الأيقونة بالنبرة نفسها). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#17E4D9FF"/></shape></item>
    <item><shape android:shape="oval">
        <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="40dp" android:startColor="#26E4D9FF" android:endColor="#00E4D9FF"/></shape></item>
    <item><shape android:shape="oval"><stroke android:width="1dp" android:color="#40E4D9FF"/></shape></item>
</layer-list>
